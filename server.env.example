# Server environment, identical for both ways of running `trove serve`:
#   Docker: copy to ./.env next to docker-compose.yml (compose reads it itself).
#   Native: copy to /etc/trove/trove.env (systemd EnvironmentFile=, see deploy/trove.service),
#           or `set -a; . ./trove.env; set +a` before `trove serve`.
# Unset or empty = the value from trove.json is used. No tokens in this file.

# Browser sign-in transport.
#
# Default: plain http works from any address, nothing to set. The password and
# session cookies are NOT encrypted on plain http: only use it on a fully
# trusted network or inside a VPN (WireGuard, Tailscale/Headscale).
# Optional: pin the accepted origin (recommended, blocks DNS rebinding):
# TROVE_WEB_ORIGIN=http://192.168.1.20:8470
#
# HTTPS only (recommended for anything beyond a trusted network): TLS in Trove
# (tls_cert/tls_key in trove.json) or at a reverse proxy. With a proxy, list its
# exact source address and have it overwrite X-Forwarded-Proto with https.
# TROVE_WEB_REQUIRE_HTTPS=1
# TROVE_WEB_ORIGIN=https://trove.example.com
# TROVE_WEB_TRUSTED_PROXIES=192.0.2.10/32

# Docker compose only (ignored by a native run):
# TROVE_BIND=127.0.0.1     # host address the port is published on; 0.0.0.0 = all
# TROVE_PORT=8470
# TROVE_UID=1000           # owner of the `trove init` files (id -u / id -g)
# TROVE_GID=1000
