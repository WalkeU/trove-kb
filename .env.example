# Client settings (copy to a private location, never commit real values).
TROVE_URL=https://kb.example.com
# Agent or reader token (sync, status, begin, submit, rebase, abort, mcp).
# Prefer a token file readable only by you over TROVE_TOKEN.
TROVE_TOKEN_FILE=/path/to/private/trove-agent-token
# TROVE_TOKEN=placeholder
# Approver token: owner's own terminal only, never in an agent environment.
# Used only by review, approve, reject, import and audit verify --remote.
# TROVE_APPROVER_TOKEN_FILE=/path/to/private/trove-approver-token
TROVE_DIR=/path/to/kb-mirror
# Plain http to a non-loopback host (VPN or tailnet) must be allowed explicitly:
# TROVE_INSECURE_HTTP=1

# Server settings are NOT here: see server.env.example (keep tokens and the
# server env file apart).